#!/usr/sbin/nft -f

flush ruleset

table inet r2Firewall {

        chain input {
                type filter hook input priority 0; policy accept;
        }

        chain forward {
                type filter hook forward priority 0; policy drop;
                ct state established,related accept

                # Allow connection initiation and ping towards DMZ from internet.
                iifname r2-eth0 ct state new,established,related accept
                iifname r2-eth0 oifname r2-eth12 icmp type echo-request accept

                # Allow DMZ to only respond to incoming connections.
                iifname r2-eth12 ip saddr 10.12.0.0/24 icmp type echo-reply accept

                # Allow workstations to initiate connection and ping.
                iifname r2-eth12 oifname r2-eth0 ip saddr 10.1.0.0/24 ct state new,established,related accept
                iifname r2-eth12 oifname r2-eth0 ip saddr 10.1.0.0/24 icmp type echo-request accept
        }

        chain output  {
                type filter hook output priority 0; policy accept;
        }

}

